# Visualizing per-bond properties with "dump image ... bond c_ID"
#
# A brittle disk (bonded particle model, BPM) is struck by a fast projectile
# and fractures.  The individual bonds are colored by the *force* carried by
# each bond, computed on the fly with "compute bond/local force", so the
# propagating stress wave and the cracks become directly visible.
#
# The relevant lines are the "compute bond/local" command and the "bond c_ID"
# value of the dump image command, together with the "dump_modify ... bmap"
# color map.  This works for any /local compute that produces one value per
# bond, e.g. "compute bond/local dist" (bond length) or "engpot" (bond
# energy), and for ordinary molecular bond styles as well as BPM bonds.
# Please also note the fix graphics/labels command to draw the color scale

units           lj
dimension       3
boundary        f f f
atom_style      bond
special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0
newton          on off
comm_modify     vel yes cutoff 2.6

lattice         fcc 1.0
region          box block -25 15 -22 22 -22 22
create_box      1 box bond/types 2 extra/bond/per/atom 20 extra/special/per/atom 50

# a thin disk (the target) ...
region          disk cylinder x 0.0 0.0 20.0 -0.5 0.5
create_atoms    1 region disk
group           plate region disk

# ... and a compact projectile aimed at its center
region          ball sphere 8.0 0.0 0.0 6.0
create_atoms    1 region ball
group           projectile region ball

displace_atoms  all random 0.1 0.1 0.1 134598738
mass            1 1.0

neighbor        1.0 bin
pair_style      bpm/spring
pair_coeff      1 1 1.0 1.0 1.0
fix             1 all nve

create_bonds    many plate plate 1 0.0 1.5
create_bonds    many projectile projectile 2 0.0 1.5

neighbor        0.3 bin
special_bonds   lj 0.0 1.0 1.0 coul 1.0 1.0 1.0

bond_style      bpm/spring
bond_coeff      1 1.0 0.04 1.0
bond_coeff      2 1.0 0.20 1.0

velocity        projectile set -0.05 0.0 0.0

# define a variable for dump output frequency, so that graphics fix and dump
# are run one the same steps and making this an index style variable lets you
# override it from the command line with -var dumpfreq 100

variable        dumpfreq index 100

# to add a color scale we have to reference a dump that has not been created.
# the fix has to come *before* the dump image command so it can be enabled by it,
# but it needs the dump-ID so it can query it for the color map information.

fix             scale all graphics/labels ${dumpfreq} &
                colorscale viz "Bond Force" 400 50 0 size 28 &
                length 950 horizontal tics 10 map bond &
                colorscale viz "Atom Kinetic Energy" 400 125 0 size 28 &
                length 800 horizontal tics 10 map atom

# for coloring atoms
compute ke all ke/atom

# for coloring bonds
compute bond_dump_viz all bond/local force

dump viz all image ${dumpfreq} fracture-*.ppm c_ke type bond c_bond_dump_viz type &
     size 800 800 zoom 1.75 view 80 50 center s 0.6 0.5 0.4 box no 0.0 &
     shiny 0.4 fsaa yes ssao yes 12453 0.4  fix scale type 1 0

# define and apply two custom color maps for atoms and bonds

dump_modify viz pad 9 backcolor black backcolor2 white adiam * 0.66 &
     color map1 0.250 0.025 0.329 color map2 0.191 0.407 0.556 &
     color map3 0.208 0.719 0.473 color map4 0.993 0.906 0.144 &
     amap 0.00001 0.003 cf 0.0 4 min map1 0.333 map2 0.667 map3 max map4 &
     color bm1 0.250 0.025 0.329 color bm2 0.611 0.090 0.620 &
     color bm3 0.928 0.473 0.326 color bm4 0.940 0.975 0.131 &
     bmap 0.001 0.5 cf 0.0 4 min bm1 0.333 bm2 0.667 bm3 max bm4 &
     lights 0.2 0.9 0.45 0.9

# broken bonds are removed from the topology, so atoms become "lost"; allow it

thermo          200
thermo_style    custom step ke pe
thermo_modify   lost ignore lost/bond ignore

timestep        0.1
run             10000
